# Copy to .env for local docker compose (never commit .env)
AKEYLESS_ACCESS_ID=
AKEYLESS_ACCESS_KEY=
# Gateway base URL — no /api/v1 suffix for most self-hosted gateways
AKEYLESS_GATEWAY_URL=https://api.akeyless.io

# Universal Identity (alternative to API key):
# AKEYLESS_ACCESS_TYPE=universal_identity
# AKEYLESS_UID_TOKEN_FILE=/run/akeyless/uid-token
